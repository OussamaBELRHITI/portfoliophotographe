# Production settings. ./setup.sh writes .env from this with real secrets — prefer that over
# copying by hand. Keep .env private (chmod 600): it holds the database and admin passwords.

# Bare domain, no https:// and no trailing slash. DNS for it (and www) must point here.
DOMAIN=example.com

# `caddy` = run the bundled Caddy for HTTPS on ports 80/443.
# Empty  = the server already has a proxy on 80/443; see DEPLOY.md, "Server already runs Caddy".
COMPOSE_PROFILES=caddy

# Localhost ports, only used when an existing host proxy forwards to the containers.
WEB_PORT=3100
API_PORT=8180

POSTGRES_PASSWORD=change-me
# Base64 HMAC key: openssl rand -base64 32
JWT_SECRET=change-me

# Creates the dashboard account on FIRST start only.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=

# Largest single upload accepted. Photos and videos are written to a Docker volume on this
# server and served by Caddy — there is nothing to sign up for and no keys to paste.
MAX_UPLOAD_SIZE=512MB
